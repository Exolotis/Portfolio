<script>
const age=()=>Math.floor((Date.now()-new Date('2004-11-15'))/31557600000);
document.getElementById('ba').textContent=age();
document.getElementById('ha').textContent=age();

// Boot sequence
document.querySelectorAll('.bl').forEach(el=>setTimeout(()=>el.classList.add('on'),+el.dataset.t));
setTimeout(()=>{
  const b=document.getElementById('boot');
  b.style.opacity='0';
  setTimeout(()=>{b.style.display='none';initScene()},800);
},4600);

// Ticker
const TICKS=[
  {tag:'CLIMATE',txt:'Record 2024 NatCat losses: $280B+ insured — Munich Re'},
  {tag:'ACTUARY',txt:'Parametric insurance emerging as primary climate response tool'},
  {tag:'CONFLICT',txt:'ACLED: 36+ active armed conflicts worldwide — Q1 2026'},
  {tag:'CYBER',txt:'$8T/year cybercrime — AI-driven fraud patterns accelerating'},
  {tag:'AV RISK',txt:'736+ AV incidents on NHTSA record — pricing gap remains'},
  {tag:'INDIA',txt:'IRDAI pushing parametric crop insurance for 250M+ farmers'},
  {tag:'CLIMATE',txt:'Global temp anomaly: +1.4°C above pre-industrial — Q1 2026'},
  {tag:'ACTUARY',txt:'GLM/GAM + EVT transforming catastrophe pricing in 2026'},
  {tag:'SOLAR',txt:'Solar irradiance volatility now core parametric trigger in green energy'},
];
(()=>{const s=document.getElementById('ts');[...TICKS,...TICKS].forEach(t=>{const d=document.createElement('div');d.className='ti';d.innerHTML=`<div class="tt">// ${t.tag}</div>${t.txt}`;s.appendChild(d)})})();

// THREE SETUP
const canvas=document.getElementById('c');
const renderer=new THREE.WebGLRenderer({canvas,antialias:true,powerPreference:'high-performance'});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.setSize(innerWidth,innerHeight);
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;
renderer.setClearColor(0x010C18);
renderer.toneMapping=THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure=2.2;
window.addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});

const scene=new THREE.Scene();
scene.fog=new THREE.FogExp2(0x010C18,.010);
const camera=new THREE.PerspectiveCamera(72,innerWidth/innerHeight,.1,600);
camera.position.set(0,8,16);

// Lights
scene.add(new THREE.AmbientLight(0x3355AA,3.5));
const sun=new THREE.DirectionalLight(0x88BBFF,4.0);
sun.position.set(15,25,15);sun.castShadow=true;
sun.shadow.mapSize.set(2048,2048);
sun.shadow.camera.left=sun.shadow.camera.bottom=-100;
sun.shadow.camera.right=sun.shadow.camera.top=100;
sun.shadow.camera.far=400;
scene.add(sun);
const rim=new THREE.DirectionalLight(0xFF4466,.6);
rim.position.set(-10,4,-15);scene.add(rim);

// Particles
const ptG=new THREE.BufferGeometry();
const ptP=new Float32Array(1200*3);
for(let i=0;i<ptP.length;i++)ptP[i]=(Math.random()-.5)*150;
ptG.setAttribute('position',new THREE.BufferAttribute(ptP,3));
const pts=new THREE.Points(ptG,new THREE.PointsMaterial({color:0x00D4FF,size:.08,transparent:true,opacity:.6}));
scene.add(pts);

// Parse and load embedded GLB
const GLB_B64 = "";

function b64ToArrayBuffer(b64){
  const bin=atob(b64);
  const buf=new ArrayBuffer(bin.length);
  const view=new Uint8Array(buf);
  for(let i=0;i<bin.length;i++)view[i]=bin.charCodeAt(i);
  return buf;
}

function parseGLB(data){
  try{
    const dv=new DataView(data);
    if(dv.getUint32(0,true)!==0x46546C67)throw'bad magic';
    const jLen=dv.getUint32(12,true);
    const json=JSON.parse(new TextDecoder().decode(new Uint8Array(data,20,jLen)));
    const bStart=20+jLen+8;
    const bLen=dv.getUint32(20+jLen,true);
    const bin=data.slice(bStart,bStart+bLen);
    const bvs=json.bufferViews||[];
    const accs=json.accessors||[];
    const T={SCALAR:1,VEC2:2,VEC3:3,VEC4:4,MAT4:16};
    function acc(i){
      if(i==null)return null;
      const a=accs[i],bv=bvs[a.bufferView];
      const off=(bv.byteOffset||0)+(a.byteOffset||0);
      const n=a.count*T[a.type];
      if(a.componentType===5126)return new Float32Array(bin,off,n);
      if(a.componentType===5123)return new Uint16Array(bin,off,n);
      if(a.componentType===5125)return new Uint32Array(bin,off,n);
    }
    const pal={Metal:0x1E3A5F,Color:0x0F2744,Color_smooth:0x1A3D6B,Gem:0x00D4FF,Emission:0x0066CC,Fog:0x0A2040};
    const mc={};
    function mat(idx){
      if(mc[idx])return mc[idx];
      const m=(json.materials||[])[idx];
      let col=0x0D1525,emit=0x000000,rough=.82,metal=.15,tr=false,op=1;
      if(m){
        const p=m.pbrMetallicRoughness||{};
        if(p.baseColorFactor){const f=p.baseColorFactor;col=new THREE.Color(f[0],f[1],f[2])}
        if(p.metallicFactor!=null)metal=p.metallicFactor;
        if(p.roughnessFactor!=null)rough=p.roughnessFactor;
        if(m.emissiveFactor){const e=m.emissiveFactor;emit=new THREE.Color(e[0],e[1],e[2])}
        if(pal[m.name])col=new THREE.Color(pal[m.name]);
        if(m.name==='Fog'){tr=true;op=.2}
      }
      return mc[idx]=new THREE.MeshStandardMaterial({color:col,emissive:emit,roughness:rough,metalness:metal,transparent:tr,opacity:op});
    }
    const meshC={};
    function mesh(mi){
      if(meshC[mi])return meshC[mi].clone();
      const md=json.meshes[mi];if(!md)return null;
      const grp=new THREE.Group();
      md.primitives.forEach(p=>{
        const g=new THREE.BufferGeometry();
        const at=p.attributes;
        const pos=acc(at.POSITION);if(!pos)return;
        g.setAttribute('position',new THREE.BufferAttribute(pos.slice(),3));
        const n=acc(at.NORMAL);if(n)g.setAttribute('normal',new THREE.BufferAttribute(n.slice(),3));
        const uv=acc(at.TEXCOORD_0);if(uv)g.setAttribute('uv',new THREE.BufferAttribute(uv.slice(),2));
        if(p.indices!=null){const id=acc(p.indices);if(id)g.setIndex(new THREE.BufferAttribute(id instanceof Uint32Array?id.slice():new Uint32Array(id),1))}
        if(!g.attributes.normal)g.computeVertexNormals();
        const m=new THREE.Mesh(g,mat(p.material));m.castShadow=true;m.receiveShadow=true;grp.add(m);
      });
      return meshC[mi]=grp;
    }
    function node(ni){
      const nd=json.nodes[ni];if(!nd)return null;
      const o=new THREE.Group();o.name=nd.name||'';
      if(nd.matrix){const mx=new THREE.Matrix4();mx.fromArray(nd.matrix);mx.decompose(o.position,o.quaternion,o.scale)}
      else{if(nd.translation)o.position.fromArray(nd.translation);if(nd.rotation)o.quaternion.fromArray(nd.rotation);if(nd.scale)o.scale.fromArray(nd.scale)}
      if(nd.mesh!=null){const m=mesh(nd.mesh);if(m)o.add(m)}
      (nd.children||[]).forEach(ci=>{const c=node(ci);if(c)o.add(c)});
      return o;
    }
    const sc=json.scenes[json.scene||0];
    const root=new THREE.Group();
    (sc.nodes||[]).forEach(ni=>{const n=node(ni);if(n)root.add(n)});
    root.scale.set(3,3,3);root.position.set(0,-4,0);root.rotation.y=Math.PI*.5;
    scene.add(root);
    for(let i=0;i<18;i++){
      const fl=new THREE.PointLight(0xFF4400,.5,8);
      fl.position.set((Math.random()-.5)*80,-1.5,(Math.random()-.5)*80);
      fl.userData.ph=Math.random()*Math.PI*2;scene.add(fl);
    }
    // Add extra fill lights
    for(let i=0;i<8;i++){const fl2=new THREE.PointLight(0x4488FF,1.2,25);fl2.position.set((Math.random()-.5)*60,8,(Math.random()-.5)*60);scene.add(fl2)}
    console.log('World loaded OK');
  }catch(e){
    console.warn('GLB parse failed:',e);
    buildFallback();
  }
}


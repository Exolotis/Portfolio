<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PRASANNA BHATKAR</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{
  --blue:#00D4FF;
  --blue2:#0088FF;
  --red:#FF2D55;
  --gold:#FFD60A;
  --green:#00FFB3;
  --pink:#FF2D78;
  --purple:#BF5FFF;
  --orange:#FF6B35;
  --grey:#A8BCCF;
  --white:#F0F8FF;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{width:100%;height:100%;background:#010C18;overflow:hidden;cursor:crosshair;font-family:'Space Mono',monospace;color:#fff}

/* BOOT */
#boot{position:fixed;inset:0;background:#010C18;z-index:9999;display:flex;flex-direction:column;justify-content:center;padding:8vw;transition:opacity .8s}
.bl{font-size:clamp(9px,1.3vw,13px);opacity:0;transform:translateX(-6px);transition:opacity .25s,transform .25s;margin-bottom:8px;letter-spacing:1px;white-space:nowrap}
.bl.w{color:var(--red)}.bl.s{color:var(--blue)}.bl.i{color:#fff;font-weight:700;font-size:clamp(10px,1.5vw,15px)}.bl.gn{color:var(--green)}
.bl.on{opacity:1;transform:translateX(0)}

/* CANVAS */
#c{position:fixed;inset:0;opacity:0;transition:opacity 1s}
#c.vis{opacity:1}

/* INTRO */
#intro{position:fixed;inset:0;z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;opacity:0;transition:opacity .5s}
#intro.vis{opacity:1;pointer-events:all}
.iname{font-family:'Syne',sans-serif;font-weight:800;font-size:clamp(36px,8vw,96px);letter-spacing:-2px;line-height:1;text-align:center}
.isub{margin-top:14px;font-size:clamp(8px,1vw,11px);letter-spacing:5px;color:var(--blue);text-align:center}
.ibtn{margin-top:48px;padding:14px 42px;border:1px solid var(--blue);background:transparent;color:var(--blue);font-family:'Space Mono',monospace;font-size:11px;letter-spacing:4px;text-transform:uppercase;cursor:pointer;transition:all .25s;animation:pb 2s ease-in-out infinite}
.ibtn:hover{background:var(--blue);color:#000}
@keyframes pb{0%,100%{box-shadow:0 0 0 rgba(0,170,255,0)}50%{box-shadow:0 0 20px rgba(0,170,255,.4)}}

/* HUD */
#hud{position:fixed;inset:0;pointer-events:none;z-index:100;opacity:0;transition:opacity .6s}
#hud.vis{opacity:1}
.hb{position:absolute;inset:10px;border:1px solid rgba(0,170,255,.2)}
.hc{position:absolute;width:20px;height:20px;border-color:var(--blue);border-style:solid}
.tl{top:10px;left:10px;border-width:2px 0 0 2px}.tr{top:10px;right:10px;border-width:2px 2px 0 0}
.bl2{bottom:10px;left:10px;border-width:0 0 2px 2px}.br2{bottom:10px;right:10px;border-width:0 2px 2px 0}
.htl{position:absolute;top:18px;left:18px;font-size:8px;letter-spacing:2px;color:var(--blue)}
.htr{position:absolute;top:18px;right:18px;font-size:8px;letter-spacing:2px;color:var(--grey);text-align:right}
.hbl{position:absolute;bottom:18px;left:18px;font-size:8px;letter-spacing:1px;color:var(--grey)}
.hbr_{position:absolute;bottom:18px;right:18px;font-size:8px;letter-spacing:1px;color:var(--grey);text-align:right}

/* ZONE LABEL */
#zl{position:fixed;top:44%;left:50%;transform:translateX(-50%);text-align:center;pointer-events:none;z-index:200;opacity:0;transition:opacity .3s}
#zl.vis{opacity:1}
#zlt{font-family:'Syne',sans-serif;font-weight:800;font-size:clamp(18px,3vw,32px);letter-spacing:3px}
#zlp{font-size:9px;letter-spacing:4px;color:var(--blue);margin-top:6px;text-transform:uppercase}
.honk{margin-top:10px;font-size:8px;letter-spacing:3px;color:rgba(0,170,255,.8);animation:fup 1.5s ease-in-out infinite}
@keyframes fup{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}

/* CONTROLS */
#ctrl{position:fixed;bottom:46px;left:50%;transform:translateX(-50%);display:flex;gap:18px;z-index:150;opacity:0;transition:opacity .5s;pointer-events:none;background:rgba(0,4,8,.7);padding:10px 20px;border:1px solid rgba(0,170,255,.15)}
#ctrl.vis{opacity:1}
.key{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:7px;letter-spacing:1.5px;color:var(--grey)}
.key span{padding:3px 7px;border:1px solid rgba(0,170,255,.4);color:var(--blue);font-size:8px}

/* SPEED */
#spd{position:fixed;bottom:44px;right:16px;font-size:7px;letter-spacing:2px;color:var(--blue);z-index:120;opacity:0;transition:opacity .5s;text-align:right}
#spd.vis{opacity:1}
#sv{font-family:'Syne',sans-serif;font-size:28px;font-weight:800;color:#fff;display:block;line-height:1}

/* MINIMAP */
#mm{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);display:flex;gap:8px;z-index:120;opacity:0;transition:opacity .5s}
#mm.vis{opacity:1}
.md{width:7px;height:7px;border-radius:50%;border:1px solid rgba(0,170,255,.4);background:transparent;cursor:pointer;pointer-events:all;transition:all .3s;font-size:0}
.md.on{background:var(--blue);box-shadow:0 0 10px var(--blue)}
.md:hover{border-color:var(--blue)}

/* TICKER */
#ticker{position:fixed;top:48px;right:0;width:195px;height:calc(100vh - 56px);background:rgba(0,4,8,.93);border-left:1px solid rgba(0,170,255,.15);z-index:110;overflow:hidden;opacity:0;transition:opacity .6s;display:flex;flex-direction:column}
#ticker.vis{opacity:1}
.thd{padding:9px 12px;font-size:7px;letter-spacing:3px;color:var(--blue);border-bottom:1px solid rgba(0,170,255,.12);flex-shrink:0}
.tst{padding:7px 12px;border-bottom:1px solid rgba(0,170,255,.08);flex-shrink:0}
.tsr{display:flex;justify-content:space-between;font-size:7px;padding:2px 0}
.tsl_{color:var(--grey)}.tsv{color:var(--blue)}
.tfw{flex:1;overflow:hidden}
.ts{display:flex;flex-direction:column;animation:tu 32s linear infinite}
.ti{padding:8px 12px;border-bottom:1px solid rgba(0,170,255,.05);font-size:7.5px;line-height:1.5;color:var(--grey)}
.tt{font-size:7px;letter-spacing:1.5px;color:var(--blue);margin-bottom:2px}
@keyframes tu{0%{transform:translateY(0)}100%{transform:translateY(-50%)}}

/* PANEL */
#panel{position:fixed;top:0;right:0;width:min(460px,92vw);height:100vh;background:rgba(1,15,35,.98);border-left:1px solid rgba(0,212,255,.4);z-index:400;transform:translateX(100%);transition:transform .45s cubic-bezier(.23,1,.32,1);overflow-y:auto;padding:58px 34px 40px;scrollbar-width:thin;scrollbar-color:rgba(0,170,255,.3) transparent}
#panel.open{transform:translateX(0)}
#px{position:absolute;top:16px;right:16px;width:32px;height:32px;border:1px solid rgba(0,170,255,.4);background:transparent;color:var(--blue);cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;transition:all .2s;pointer-events:all;font-family:'Space Mono',monospace}
#px:hover{background:var(--blue);color:#000}
.ptag{font-size:8px;letter-spacing:3px;color:var(--blue);margin-bottom:10px;text-transform:uppercase;opacity:.9}
.ptitle{font-family:'Syne',sans-serif;font-weight:800;font-size:clamp(22px,3.5vw,32px);line-height:1.05;margin-bottom:20px;color:var(--white)}
.pb{font-size:11.5px;line-height:1.9;color:var(--grey);margin-bottom:14px}
.ps{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid rgba(0,170,255,.1);font-size:10px}
.psl{color:var(--grey);letter-spacing:1px}.psv{color:var(--blue);font-weight:700;text-align:right;font-size:11px}
.pdiv{height:1px;background:linear-gradient(90deg,var(--blue),transparent);margin:20px 0;opacity:.4}
.sec-hd{font-family:'Syne',sans-serif;font-weight:800;font-size:17px;color:var(--white);margin:16px 0 10px;border-left:3px solid var(--blue);padding-left:10px}
.sec-sub{font-size:8px;letter-spacing:3px;color:var(--blue);text-transform:uppercase;margin-bottom:6px}
.sec-role{font-size:10px;color:var(--green);letter-spacing:2px;margin-bottom:10px;text-transform:uppercase}
.sec-date{font-size:8px;color:var(--grey);letter-spacing:1px;margin-bottom:12px}
.bullet{font-size:11px;color:var(--grey);line-height:1.8;padding-left:14px;position:relative;margin-bottom:5px}
.bullet::before{content:'→';position:absolute;left:0;color:var(--blue);font-size:9px}
.badge{display:inline-block;padding:3px 9px;border:1px solid currentColor;font-size:8px;letter-spacing:2px;text-transform:uppercase;margin:3px 3px 3px 0}
.bb{color:var(--blue);border-color:rgba(0,212,255,.4);background:rgba(0,212,255,.06)}.bg{color:var(--gold);border-color:rgba(255,214,10,.4);background:rgba(255,214,10,.06)}
.bgr{color:var(--green);border-color:rgba(0,255,179,.4);background:rgba(0,255,179,.06)}.br{color:var(--red);border-color:rgba(255,45,85,.4);background:rgba(255,45,85,.06)}
.sg{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:12px 0}
.sc{padding:11px;border:1px solid rgba(0,170,255,.12);background:rgba(0,170,255,.03)}
.scl{font-size:7px;letter-spacing:2px;color:var(--grey);margin-bottom:4px}.scv{font-family:'Syne',sans-serif;font-size:15px;font-weight:800;color:var(--white)}
.skw{margin-bottom:11px}.skr{display:flex;justify-content:space-between;font-size:8px;color:var(--grey);margin-bottom:4px}
.skt{height:2px;background:rgba(0,170,255,.12)}.skf{height:100%;background:linear-gradient(90deg,var(--blue2),var(--blue));transform:scaleX(0);transform-origin:left;transition:transform 1.1s cubic-bezier(.23,1,.32,1);box-shadow:0 0 8px var(--blue)}
.skf.go{transform:scaleX(1)}.skf.gn{background:linear-gradient(90deg,#00BB88,var(--green));box-shadow:0 0 8px var(--green)}
.cl_{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid rgba(0,170,255,.1);text-decoration:none;transition:padding-left .2s;color:inherit}
.cl_:hover{padding-left:8px}.ci_{font-size:17px;flex-shrink:0}
.clt{font-size:7px;letter-spacing:2px;color:var(--grey);text-transform:uppercase}
.clv{font-size:10px;color:var(--blue);margin-top:2px;font-weight:700}
.cf{display:flex;flex-direction:column;gap:9px;margin-top:12px}
.ci{background:rgba(0,170,255,.04);border:1px solid rgba(0,170,255,.2);padding:10px 12px;color:#fff;font-family:'Space Mono',monospace;font-size:10px;outline:none;transition:border-color .3s;width:100%;resize:none}
.ci:focus{border-color:var(--blue)}
.csb{padding:12px;background:transparent;border:1px solid var(--blue);color:var(--blue);font-family:'Space Mono',monospace;font-size:9px;letter-spacing:3px;text-transform:uppercase;cursor:pointer;transition:all .3s}
.csb:hover{background:var(--blue);color:#000}
#grain{position:fixed;inset:0;z-index:9990;pointer-events:none;opacity:.03;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");background-size:180px}
@media(max-width:700px){
  #ticker{display:none}
  #panel{width:100vw;padding:52px 18px 120px}
  #ctrl{display:none}
  #spd{bottom:auto;top:56px;right:10px;font-size:6px}
  #sv{font-size:20px}
  #mm{bottom:6px}
  .hbl{font-size:7px;max-width:55vw;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .hbr_{display:none}
  canvas#mapcanvas{width:100px!important;height:100px!important;top:auto;bottom:52px;left:8px}
  #zl{top:42%}
  #zlt{font-size:clamp(14px,5vw,22px)}
  .honk{font-size:8px}
}

/* MOBILE TOUCH CONTROLS */
#mctrl{display:none;position:fixed;bottom:55px;z-index:300;pointer-events:all;width:100%;left:0}
@media(max-width:700px){#mctrl{display:flex;justify-content:space-between;align-items:flex-end;padding:0 12px}}

/* Joystick */
#jpad{position:relative;width:110px;height:110px;flex-shrink:0}
#jbase{width:110px;height:110px;border-radius:50%;border:1px solid rgba(0,170,255,.25);background:rgba(0,4,8,.7);position:absolute}
#jknob{width:44px;height:44px;border-radius:50%;background:rgba(0,212,255,.18);border:1.5px solid var(--blue);position:absolute;left:33px;top:33px;transition:left .05s,top .05s;box-shadow:0 0 12px rgba(0,212,255,.3)}

/* Right action buttons */
#mbtns{display:flex;flex-direction:column;gap:8px;align-items:flex-end;flex-shrink:0}
.mbtn{width:52px;height:52px;border-radius:50%;border:1.5px solid rgba(0,170,255,.35);background:rgba(0,4,8,.75);color:var(--blue);font-family:'Space Mono',monospace;font-size:9px;letter-spacing:1px;display:flex;align-items:center;justify-content:center;cursor:pointer;user-select:none;-webkit-user-select:none;touch-action:none;transition:background .15s,box-shadow .15s}
.mbtn:active,.mbtn.held{background:rgba(0,212,255,.2);box-shadow:0 0 14px rgba(0,212,255,.4)}
#mbhonk{width:62px;height:62px;border-color:rgba(0,212,255,.5);font-size:10px;letter-spacing:2px}
</style>

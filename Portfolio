  console.log('Using fallback world');
  const pm=new THREE.MeshStandardMaterial({color:0x1A3050,roughness:.75,metalness:.3});
  const em=new THREE.MeshStandardMaterial({color:0x00AAFF,emissive:0x00AAFF,emissiveIntensity:.8,roughness:.3});

let speed=0,hph=0,near=null,baseY=1.5,vertVel=0;
const ACCEL=.019,BRAKE=.009,FRIC=.925,MAX=.65,TURN=.031,VERT=.06;

function updateCar(dt){
  const fwd=new THREE.Vector3(-Math.sin(car.rotation.y),0,-Math.cos(car.rotation.y));
  const k=(c)=>keys[c]||mkeys[c];
  let ac=k('KeyW')||k('ArrowUp')?ACCEL:k('KeyS')||k('ArrowDown')?-BRAKE:0;
  let tr=0;
  if(Math.abs(speed)>.008){
    if(k('KeyA')||k('ArrowLeft'))tr=TURN;
    if(k('KeyD')||k('ArrowRight'))tr=-TURN;
  }
  if(k('Space')||k('KeyQ'))vertVel=Math.min(vertVel+.008,.18);
  else if(k('ShiftLeft')||k('ShiftRight')||k('KeyZ'))vertVel=Math.max(vertVel-.008,-.18);
  else vertVel*=.88;
  baseY=Math.max(-1,Math.min(18,baseY+vertVel));
  speed=Math.max(-MAX*.4,Math.min(MAX,(speed+ac)*FRIC));
  if(Math.abs(speed)<.0005)speed=0;
  car.rotation.y+=tr*(speed/MAX);
  car.position.addScaledVector(fwd,speed);
  hph+=dt;
  car.position.y=baseY+Math.sin(hph*1.9)*.13;
  car.rotation.z=THREE.MathUtils.lerp(car.rotation.z,-tr*2.6,.08);
  car.rotation.x=THREE.MathUtils.lerp(car.rotation.x,ac>.005?.085:ac<-.003?-.055:0,.065);
  const sp=Math.abs(speed)/MAX;
  car.userData.hov.intensity=1.4+sp*2.8;
  car.userData.ug.material.emissiveIntensity=1.3+sp*2.0;
  document.getElementById('sv').textContent=Math.round(sp*200);
  document.getElementById('alt').textContent=Math.round(baseY*3);
}


function buildCar(){
  const G=new THREE.Group();
  const BM=new THREE.MeshStandardMaterial({color:0x040810,roughness:.18,metalness:.97});
  const GM=new THREE.MeshStandardMaterial({color:0x001133,transparent:true,opacity:.5,roughness:.04,metalness:.3});
  const GLW=new THREE.MeshStandardMaterial({color:0x00AAFF,emissive:0x00AAFF,emissiveIntensity:1.4});
  const DK=new THREE.MeshStandardMaterial({color:0x020408,roughness:.6,metalness:.5});
  const THR=new THREE.MeshStandardMaterial({color:0x002244,emissive:0x0055AA,emissiveIntensity:.9});

  // Main hull
  const add=(w,h,d,x,y,z,m,rx=0,ry=0,rz=0)=>{
    const mesh=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),m);
    mesh.position.set(x,y,z);mesh.rotation.set(rx,ry,rz);mesh.castShadow=true;G.add(mesh);return mesh;
  };
  add(3.8,.44,1.8, 0,.04,0, BM);        // lower hull
  add(2.8,.36,1.5, -.1,.46,0, BM);      // upper body
  add(.9,.32,.95, 1.85,.27,0, BM);      // nose
  add(.5,.2,1.85, -2.0,.14,0, DK);      // rear diffuser
  add(1.1,.055,1.95, -1.65,.7,0, BM);   // spoiler
  // spoiler legs
  add(.055,.28,.055, -1.5,.54,.8, BM);
  add(.055,.28,.055, -1.5,.54,-.8, BM);
  // side skirts glow
  add(3.0,.14,.09, 0,.01,.91, GLW);
  add(3.0,.14,.09, 0,.01,-.91, GLW);
  // cockpit glass
  add(1.75,.28,1.15, .18,.64,0, GM);
  add(1.8,.055,1.2, .18,.52,0, BM);
  // glow bars
  add(.055,.055,1.8, 1.9,.27,0, GLW);
  add(.055,.055,1.8, -1.9,.27,0, GLW);
  // underbody plate
  const ug=new THREE.Mesh(new THREE.BoxGeometry(3.1,.022,1.45),new THREE.MeshStandardMaterial({color:0x00AAFF,emissive:0x00AAFF,emissiveIntensity:1.7,transparent:true,opacity:.6}));
  ug.position.set(0,-.19,0);G.add(ug);
  // thrusters
  [[1.35,-.15,.66],[1.35,-.15,-.66],[-1.35,-.15,.66],[-1.35,-.15,-.66]].forEach(([x,y,z])=>{
    const t=new THREE.Mesh(new THREE.CylinderGeometry(.19,.25,.36,12),THR);
    t.rotation.x=Math.PI/2;t.position.set(x,y,z);G.add(t);
    const tg=new THREE.Mesh(new THREE.CircleGeometry(.17,12),new THREE.MeshStandardMaterial({color:0x0088FF,emissive:0x0088FF,emissiveIntensity:2.4,side:THREE.DoubleSide}));
    tg.rotation.x=Math.PI/2;tg.position.set(x,y,z-.2);tg.userData.thr=true;G.add(tg);
  });
  // lights
  const hl=new THREE.PointLight(0x88CCFF,3.2,15);hl.position.set(2,.28,.5);G.add(hl);
  const hr=new THREE.PointLight(0x88CCFF,3.2,15);hr.position.set(2,.28,-.5);G.add(hr);
  const hov=new THREE.PointLight(0x0055FF,2.5,5);hov.position.set(0,-.5,0);G.add(hov);
  G.userData={hov,ug,thrs:G.children.filter(c=>c.userData&&c.userData.thr)};
  return G;
}


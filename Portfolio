// Minimap
const mapCtx=document.getElementById('mapcanvas').getContext('2d');
const ZONE_POS_LIST=[[0,2],[22,8],[-22,8],[15,-22],[-15,-22],[28,-14],[-28,-14],[0,-34]];
const ZONE_LABELS=['AB','EX','PR','SK','ED','WN','MU','CT'];
function drawMap(){
  const W=160,H=160,scale=2.2,cx=W/2,cy=H/2;
  mapCtx.clearRect(0,0,W,H);
  // Grid
  mapCtx.strokeStyle='rgba(0,170,255,0.08)';mapCtx.lineWidth=1;
  for(let i=0;i<=8;i++){
    const x=i*(W/8);mapCtx.beginPath();mapCtx.moveTo(x,0);mapCtx.lineTo(x,H);mapCtx.stroke();
    const y=i*(H/8);mapCtx.beginPath();mapCtx.moveTo(0,y);mapCtx.lineTo(W,y);mapCtx.stroke();
  }
  // Zones
  ZONE_POS_LIST.forEach(([zx,zz],i)=>{
    const px=cx+zx*scale,py=cy-zz*scale;
    const isNear=near&&near.userData.idx===i;
    mapCtx.beginPath();
    mapCtx.arc(px,py,isNear?5:3.5,0,Math.PI*2);
    mapCtx.fillStyle=isNear?'#00AAFF':'rgba(0,170,255,0.5)';
    mapCtx.fill();
    if(isNear){mapCtx.strokeStyle='rgba(0,170,255,0.8)';mapCtx.lineWidth=1;mapCtx.stroke();}
    mapCtx.fillStyle=isNear?'#fff':'rgba(0,170,255,0.7)';
    mapCtx.font='7px Space Mono,monospace';
    mapCtx.textAlign='center';
    mapCtx.fillText(ZONE_LABELS[i],px,py-7);
  });
  // Car
  const cpx=cx+car.position.x*scale,cpy=cy-car.position.z*scale;
  mapCtx.save();
  mapCtx.translate(cpx,cpy);
  mapCtx.rotate(-car.rotation.y);
  mapCtx.beginPath();
  mapCtx.moveTo(0,-6);mapCtx.lineTo(4,4);mapCtx.lineTo(-4,4);mapCtx.closePath();
  mapCtx.fillStyle='#00FF88';
  mapCtx.shadowColor='#00FF88';mapCtx.shadowBlur=6;
  mapCtx.fill();
  mapCtx.restore();
  // Label
  mapCtx.fillStyle='rgba(0,170,255,0.5)';mapCtx.font='7px Space Mono,monospace';mapCtx.textAlign='left';
  mapCtx.fillText('// MAP',4,12);
}

// Render loop
const clock=new THREE.Clock();
let active=false;

function render(){
  requestAnimationFrame(render);
  const dt=clock.getDelta(),t=clock.getElapsedTime();
  pts.rotation.y=t*.008;
  scene.children.forEach(c=>{
    if(c instanceof THREE.PointLight&&c.userData.ph!==undefined)
      c.intensity=.45+Math.sin(t*5+c.userData.ph)*.3;
  });
  markers.forEach(m=>{
    m.userData.r1.rotation.z=t*.5+m.userData.ph;
    m.userData.r2.rotation.z=-t*.35+m.userData.ph;
    m.userData.r1.rotation.x=Math.sin(t*.35+m.userData.ph)*.1;
    const close=car.position.distanceTo(m.position)<7;
    m.userData.r1.material.emissiveIntensity=close?2.6:.9;
    m.userData.pl.intensity=close?4.0:1.4+Math.sin(t*1.8+m.userData.ph)*.4;
  });
  car.userData.thrs.forEach((g,i)=>{if(g.material)g.material.emissiveIntensity=1.7+Math.sin(t*9+i)*.8});
  if(active){updateCar(dt);updateCam();checkZones();drawMap()}
  renderer.render(scene,camera);
}
render();


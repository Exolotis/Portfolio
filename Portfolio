// ── MOBILE JOYSTICK ──────────────────────────────────────
const mkeys={};
(()=>{
  const jpad=document.getElementById('jpad');
  const jknob=document.getElementById('jknob');
  const R=110,KR=22,CR=R/2-KR; // container radius, knob radius, clamp radius
  let jid=null,jox=0,joy=0;

  function jPos(e){
    const t=[...e.touches].find(t=>t.identifier===jid);
    if(!t)return;
    const rect=jpad.getBoundingClientRect();
    const dx=t.clientX-(rect.left+R/2);
    const dy=t.clientY-(rect.top+R/2);
    const dist=Math.min(Math.hypot(dx,dy),CR);
    const ang=Math.atan2(dy,dx);
    jox=Math.cos(ang)*dist;
    joy=Math.sin(ang)*dist;
    jknob.style.left=(R/2-KR+jox)+'px';
    jknob.style.top=(R/2-KR+joy)+'px';
    // Map to keys: forward/back on Y, turn on X
    const nx=jox/CR, ny=joy/CR;
    mkeys.KeyW=ny<-.25;
    mkeys.KeyS=ny>.25;
    mkeys.KeyA=nx<-.25;
    mkeys.KeyD=nx>.25;
  }

  jpad.addEventListener('touchstart',e=>{
    e.preventDefault();
    if(jid!==null)return;
    jid=e.changedTouches[0].identifier;
    jPos(e);
  },{passive:false});

  jpad.addEventListener('touchmove',e=>{e.preventDefault();jPos(e);},{passive:false});

  jpad.addEventListener('touchend',e=>{
    [...e.changedTouches].forEach(t=>{if(t.identifier===jid){jid=null;}});
    if(jid===null){
      jox=0;joy=0;
      jknob.style.left=(R/2-KR)+'px';
      jknob.style.top=(R/2-KR)+'px';
      mkeys.KeyW=false;mkeys.KeyS=false;mkeys.KeyA=false;mkeys.KeyD=false;
    }
  },{passive:false});

  // Fly/Dip buttons
  const mbup=document.getElementById('mbup');
  const mbdown=document.getElementById('mbdown');
  mbup.addEventListener('touchstart',e=>{e.preventDefault();mkeys.Space=true;},{passive:false});
  mbup.addEventListener('touchend',()=>{mkeys.Space=false;});
  mbdown.addEventListener('touchstart',e=>{e.preventDefault();mkeys.ShiftLeft=true;},{passive:false});
  mbdown.addEventListener('touchend',()=>{mkeys.ShiftLeft=false;});
  document.getElementById('mbhonk').addEventListener('touchstart',e=>{e.preventDefault();honk();},{passive:false});

  // Camera drag on canvas for mobile
  let cid=null,clx=0,cly=0;
  const cv=document.getElementById('c');
  cv.addEventListener('touchstart',e=>{
    // Only use touches not on jpad
    const t=e.changedTouches[0];
    const r=jpad.getBoundingClientRect();
    const inJoy=t.clientX>=r.left&&t.clientX<=r.right&&t.clientY>=r.top&&t.clientY<=r.bottom;
    if(!inJoy&&cid===null){cid=t.identifier;clx=t.clientX;cly=t.clientY;}
  },{passive:true});
  cv.addEventListener('touchmove',e=>{
    const t=[...e.touches].find(t=>t.identifier===cid);
    if(!t)return;
    camYaw+=(t.clientX-clx)*.005;
    camPitch=Math.max(0,Math.min(.65,camPitch+(t.clientY-cly)*.004));
    clx=t.clientX;cly=t.clientY;
  },{passive:true});
  cv.addEventListener('touchend',e=>{
    [...e.changedTouches].forEach(t=>{if(t.identifier===cid)cid=null;});
  },{passive:true});
})();

